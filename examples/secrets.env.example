# The secrets dialout.yaml references as ${VAR}. Copy to secrets.env next to dialout.yaml (or
# /run/secrets/dialout.env in the container, with secrets_file pointing to it) and keep it out of
# any repository. Variables already set in the environment win over this file.
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_API_KEY_SID=SK00000000000000000000000000000000
TWILIO_API_KEY_SECRET=replace-me
TWILIO_AUTH_TOKEN=replace-me

# Only for the engine or the tunnel you use.
#ELEVENLABS_API_KEY=replace-me
#OPENAI_API_KEY=replace-me
#CF_TUNNEL_TOKEN=replace-me

# dialout serve: openssl rand -hex 32
#DIALOUT_MCP_TOKEN=replace-me
